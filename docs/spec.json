  "dbSchema": {
    "tables": {
      "users": {
        "purpose": "인증 마스터",
        "key": "id (uuid)",
        "uniqueWhereNotNull": ["username", "phone", "email"],
        "fields": ["role (customer/warehouse_staff/store_staff/admin)", "storeId (store_staff)", "passwordHash", "isActive", "lastLoginAt", "permissions text[] (NULL = ROLE_DEFAULTS, 배열 = override — 마이그레이션 0008)"]
      },
      "customers": {
        "purpose": "고객 정보 (users 와 1:1)",
        "fields": ["name", "gender", "birthDate", "phone", "postalCode", "addressLine1/2", "landlinePhone", "memberType", "refundBank (jsonb)", "referrerCode", "referredByCode", "referredById"]
      },
      "customer_prescriptions": {
        "purpose": "도수 이력 (재주문 편의)",
        "fields": ["eyeSide (left/right/both)", "sphere", "cylinder", "axis", "addPower", "source", "recordedAt"]
      },
      "brands": {
        "purpose": "제품 브랜드 마스터 (확정 2026-05-19)",
        "fields": ["nameKo (unique-when-not-null)", "nameEn", "code (3자 영문 약자, unique-when-not-null, 예: CHR/ACU)", "isActive", "deletedAt"],
        "ui": "제품 등록 폼 (/admin/products/new, /admin/products/[id]) 의 브랜드 필드가 select 드롭다운 + 옆 '등록' 버튼 → BrandManagerModal",
        "api": ["GET /api/admin/brands (활성 목록)", "POST /api/admin/brands (영문/국문/약자, unique 검증, requireAdmin)"],
        "note": "lenses.brand (text) 는 호환을 위해 그대로 유지 — 폼에서 선택 시 brands.nameKo 값을 lenses.brand 에 저장. 추후 lenses.brandId FK 도입 가능."
      },
      "lens_price_entries": {
        "purpose": "매입/공급/소비자 정적 가격의 시계열 (확정 2026-05-19)",
        "fields": ["lensId (FK lenses cascade)", "scope (purchase/supply/retail)", "standard", "discountAmount", "discountPercent", "startsAt (default now)", "endsAt (NULL=무기한)", "isActive", "note"],
        "model": "사용자가 매입/공급/소비자 가격 변경 시 '언제부터' 입력. 시작일 ≤ now → lenses 캐시 컬럼 즉시 갱신 / 미래 시작일 → entry 만 INSERT (예약). 종료일 미입력 = 다음 변경 전까지 유지.",
        "cacheSync": "src/lib/lens-pricing-entries.ts createPriceEntryAndSyncCache(lensId, input)",
        "future": "cron/lazy 로 미래 entry 가 startsAt 도달 시 캐시 자동 갱신 (현재는 entries 가 진실, 캐시는 즉시 적용용)"
      },
      "lens_promotions": {
        "purpose": "기간/조건부 프로모션 가격 (확정 2026-05-19)",
        "fields": [
          "lensId (FK lenses cascade)",
          "kind (sale/promotion/volume_bundle)",
          "discountAmount, discountPercent",
          "storeTier (sale 전용, NULL=전체)",
          "buyQty, freeQty (volume_bundle 전용, 1+1: buy=1 free=1)",
          "startsAt, endsAt (NULL=무기한)",
          "isActive, note"
        ],
        "ui": "lens 편집 페이지 (/admin/products/[id]) 의 가격 카드 아래 LensPromotionsCard — sale/promotion/volume_bundle 탭형 추가 + 리스트 (활성화 토글 + 삭제)",
        "api": [
          "GET /api/admin/lenses/[id]/promotions (조회)",
          "POST /api/admin/lenses/[id]/promotions (z.discriminatedUnion 검증, 기간 정합성)",
          "PATCH /api/admin/promotions/[id] (활성화 토글 + 기간/메모 수정)",
          "DELETE /api/admin/promotions/[id] (soft-delete, products_write 권한)"
        ]
      },
      "product_codes": {
        "purpose": "제품 시리즈/모델 코드 마스터 (확정 2026-05-19)",
        "fields": ["nameKo (unique-when-not-null)", "nameEn (모달 리스트 영문 정렬 기준)", "code (3자 [A-Z0-9])", "suffix (2자 [A-Z0-9])", "isActive", "deletedAt"],
        "uniqueWhereNotNull": ["nameKo", "(code, suffix) 조합"],
        "ui": "제품 등록 폼의 '제품 코드' input 옆 '등록' 버튼 → ProductCodeManagerModal. 모달의 행에서 '선택' 클릭 시 현재 선택된 브랜드의 약자 + code + suffix 가 자동 조합되어 lenses.productCode 에 채워짐 (형식: {brand.code}-{pc.code}{pc.suffix} = 예: CHR-OOL1D 11자)",
        "api": ["GET /api/admin/product-codes (활성, 영문 정렬)", "POST /api/admin/product-codes (영문/국문/3자/2자, code+suffix unique 검증)"]
      },
