  "infra": {
    "github": {
      "repo": "jiny8366/funnyview-pickup",
      "branch": "main",
      "frameOpsRelation": "완전 무관 (PAT 직접 push)"
    },
    "vercel": {
      "project": "funnyview-pickup",
      "productionBranch": "main",
      "region": "icn1 (Seoul)",
      "buildCommand": "npm run vercel:build",
      "vercelBuild": "drizzle-kit migrate && next build",
      "domains": [
        "funnyview-pickup.vercel.app (메인/고객)",
        "admin-funnyview-pickup.vercel.app (관리자)",
        "staff-funnyview-pickup.vercel.app (픽업서비스 운영)",
        "store-funnyview-pickup.vercel.app (픽업가맹점)"
      ]
    },
    "neon": {
      "region": "Asia Pacific Singapore (ap-southeast-1)",
      "database": "neondb",
      "connectionMode": "Pooled (Vercel serverless 필수)"
    },
    "envVars": {
      "required": [
        "DATABASE_URL (Neon pooled)",
        "JWT_SECRET (32+ random)",
        "SESSION_COOKIE_NAME=funnyview_pickup_session",
        "SESSION_MAX_AGE_DAYS=30",
        "NEXT_PUBLIC_APP_NAME=Funnyview Pickup",
        "NEXT_PUBLIC_APP_URL=https://funnyview-pickup.vercel.app",
        "NOTIFICATION_PROVIDER=console",
        "VAPID_SUBJECT=mailto:admin@funnyview.local"
      ],
      "optional": [
        "KAKAO_REST_API_KEY (geocoding)",
        "REDIS_URL (Upstash)",
        "NAVER_CLIENT_ID / SECRET",
        "KAKAO_CLIENT_ID / SECRET",
        "GOOGLE_CLIENT_ID / SECRET",
        "SOLAPI_API_KEY / SECRET / SENDER",
        "VAPID_PUBLIC_KEY / PRIVATE_KEY",
        "NEXT_PUBLIC_HOST_ADMIN / STAFF / STORE (자체 도메인 전환 시)",
        "NEXT_PUBLIC_SHOW_TEST_ACCOUNTS (=0 으로 숨김)"
      ]
    }
  },

  "portals": {
    "model": "hostname-based 4 portal 분리",
    "resolver": "src/lib/portal.ts — hostname prefix 또는 ENV 매핑",
    "list": [
      {
        "kind": "customer",
        "label": "고객",
        "host": "funnyview-pickup.vercel.app (또는 funnyview.kr)",
        "entryPath": "/",
        "allowedPaths": ["/", "/customer", "/login", "/register", "/onboarding", "/order", "/my", "/stores", "/api/auth", "/api/orders", "/api/lenses", "/api/stores", "/api/home", "/api/notifications", "/api/push", "/api/events"]
      },
      {
        "kind": "admin",
        "label": "관리자",
        "host": "admin-funnyview-pickup.vercel.app (또는 admin.funnyview.kr)",
        "entryPath": "/login/admin",
        "allowedPaths": ["/admin", "/login/admin", "/api/admin", "/api/auth"]
      },
      {
        "kind": "staff",
        "label": "픽업서비스 업체",
        "host": "staff-funnyview-pickup.vercel.app",
        "entryPath": "/login/warehouse",
        "allowedPaths": ["/warehouse", "/login/warehouse", "/api/warehouse", "/api/auth", "/api/notifications", "/api/push", "/api/events"]
      },
      {
        "kind": "store",
        "label": "픽업가맹점",
        "host": "store-funnyview-pickup.vercel.app",
        "entryPath": "/login/store",
        "allowedPaths": ["/store", "/login/store", "/api/store", "/api/auth", "/api/notifications", "/api/push", "/api/events"]
      }
    ],
    "rolePathRules": {
      "customer": ["/customer"],
      "warehouse_staff": ["/warehouse"],
      "store_staff": ["/store"],
      "admin": ["/customer", "/warehouse", "/store", "/admin"]
    }
  },

