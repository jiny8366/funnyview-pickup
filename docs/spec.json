  },

  "dbSchema": {
    "tables": {
      "users": {
        "purpose": "인증 마스터",
        "key": "id (uuid)",
        "uniqueWhereNotNull": ["username", "phone", "email"],
        "fields": ["role (customer/warehouse_staff/store_staff/admin)", "storeId (store_staff)", "passwordHash", "isActive", "lastLoginAt"]
      },
      "customers": {
        "purpose": "고객 정보 (users 와 1:1)",
        "fields": ["name", "gender", "birthDate", "phone", "postalCode", "addressLine1/2", "landlinePhone", "memberType", "refundBank (jsonb)", "referrerCode", "referredByCode", "referredById"]
      },
      "customer_prescriptions": {
        "purpose": "도수 이력 (재주문 편의)",
        "fields": ["eyeSide (left/right/both)", "sphere", "cylinder", "axis", "addPower", "source", "recordedAt"]
      },
      "stores": {
        "purpose": "픽업가맹점 마스터",
        "fields": ["code (J001~)", "name", "phone", "postalCode", "addressLine1/2", "latitude", "longitude", "kakaoMapUrl", "naverMapUrl", "tmapUrl", "businessHours (jsonb)", "businessNumber", "representativeName", "commissionRate (%)", "sortOrder", "isActive"]
      },
      "lenses": {
        "purpose": "제품 마스터 (브랜드/제품군)",
        "fields": [
          "productCode (unique)",
          "brand / name",
          "lensType (spherical/toric/multifocal/color/circle)",
          "replacementCycle (1day/2week/1month/3month/6month/1year)",
          "baseCurve / diameter / waterContent / material",
          "piecesPerBox",
          "sphereMin/Max/Step, cylinderMin/Max/Step, axisStep",
          "price, cost",
          "mfdsPermitNo (식약처 허가번호)",
          "mfdsClassificationCode (분류번호 A07020)",
          "mfdsProductName (식약처 등록 품목명)",
          "manufacturer (제조원)",
          "udiSyncedAt",
          "imageUrl (대표 모델 이미지)",
          "description (블록 JSON)",
          "colorName / colorHex / colorPreviewUrl (카드)",
          "seriesCode (컬러 그루핑)",
          "isNew (뱃지)",
          "isActive"
        ]
      },
      "lens_variants": {
        "purpose": "도수별 SKU",
        "fields": ["lensId (FK)", "sku (unique, 결정적 생성)", "sphere", "cylinder", "axis", "addPower", "udiDi (GTIN-13, unique-when-not-null)", "priceOverride", "isActive"]
      },
      "lens_barcodes": {
        "purpose": "다중 바코드 (1:N)",
        "fields": ["variantId (FK)", "barcode (unique)", "barcodeType (udi_di/manufacturer_ean/internal/legacy)", "isPrimary"]
      },
      "inventory": {
        "purpose": "SKU별 현재 재고",
        "fields": ["variantId (FK, unique)", "quantityOnHand", "quantityReserved", "safetyStock", "reorderPoint", "location", "lastCountedAt"]
      },
      "inventory_movements": {
        "purpose": "Append-only audit log",
        "fields": ["variantId", "movementType (inbound/outbound/reserve/release/adjust/return)", "quantity (부호 포함)", "referenceType/Id", "note", "performedBy"]
      },
      "orders": {
        "fields": ["orderNumber", "customerId", "pickupStoreId", "status (pending/paid/accepted/picking/shipped/arrived/ready/completed/cancelled)", "subtotal", "discount", "total", "isPaid", "각 상태별 timestamp"]
      },
      "order_items": {
        "fields": ["orderId", "variantId", "eyeSide", "quantity", "unitPrice/lineTotal/unitCost", "lensName/Brand (snapshot)", "sphere/cylinder/axis/addPower (snapshot)", "skuSnapshot"]
      },
      "order_status_history": "상태 전환 감사",
      "payments": "결제 기록",
      "notifications": {
        "types": ["order_received", "order_shipped", "order_arrived", "pickup_ready", "pickup_completed", "low_stock"],
        "channels": ["app", "sms", "kakao", "email"]
      },
      "push_subscriptions": "VAPID 푸시 구독",
      "user_oauth_accounts": "소셜 로그인 연동",
      "home_sections": "CMS 섹션 (hero/product_grid/category_chips/banner_strip/countdown/brand_story)",
      "home_section_events": "노출/클릭/전환 (CTR/CVR)",
      "referral_rewards": "추천인 3% 리워드"
    },
    "views": [
      "v_sales_daily — 일별/가맹점별 매출",
      "v_sales_monthly — 월별/가맹점별 매출",
      "v_store_settlement — 가맹점 정산 (수수료율 적용)",
      "v_low_stock_alerts — 안전재고 미달 SKU"
    ],
    "migrations": [
      "0000_0000_initial — 19 테이블",
      "0001_0002_oauth — OAuth 계정",
      "0001_sales_views — 4 SQL 뷰 (수동 적용)",
      "0002_0003_home_cms — CMS",
      "0003_0004_push — 웹 푸시",
      "0004_0005_referral — 추천인",
      "0005 — 식약처 UDI 컬럼 (lenses 5개, lens_variants.udi_di)",
      "0006 — username 컬럼 (users), 회원가입 필드 (customers landline/memberType/refundBank)",
      "0007 — 카페24 카드 컬럼 (lenses 5개: colorName/Hex/PreviewUrl/seriesCode/isNew)"
    ]
  },

  "lensDisplay": {
    "format": "계층형 슬래시 구분",
    "patterns": {
      "full": "{brand} / {name} / {cycle} / {pack}매 / SPH {sph} [/ CYL {cyl} / AX {axis}] [/ ADD {add}]",
      "compact": "{brand} / {name} / SPH {sph}",
      "spec": "SPH {sph} / CYL {cyl} / AX {axis} / ADD {add}",
      "sku": "{sku}"
