{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": ".next",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/pickup-reminders",
      "schedule": "0 0 * * *"
    }
  ]
}
